__pycache__/
.pytest_cache/
.venv/
# test results and technical logs (the folders stay, the content is not committed)
logs/*
!logs/.gitkeep
.logs/*
!.logs/README.txt
# saved screens and graph data (dashboard keys e / t / s): the folders stay, the content is not committed
scr/*
!scr/.gitkeep
!scr/graphs/
scr/graphs/*
!scr/graphs/.gitkeep
